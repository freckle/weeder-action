{
  "name": "weeder-action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Annotate unused functions in a Haskell project",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && ncc build lib/main.js --minify",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "knip": "knip",
    "readme": "npx action-docs -u && prettier --write README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/weeder-action.git"
  },
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/tool-cache": "^4.0.0",
    "semver": "^7.8.5",
    "temp": "^0.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "@types/semver": "^7.8.0",
    "@types/temp": "^0.9.4",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "knip": "^6.36.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
