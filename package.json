{
  "name": "weeder-action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Annotate unused functions in a Haskell project",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && ncc build lib/main.js --minify",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "knip": "knip",
    "readme": "npx action-docs -u && prettier --write README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/weeder-action.git"
  },
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/tool-cache": "^4.0.0",
    "semver": "^7.8.5",
    "temp": "^0.9.4"
  },
  "devDependencies": {
    "@freckle/eslint-config": "^1.3.4",
    "@freckle/prettier-config": "^1.3.4",
    "@freckle/tsconfig": "^1.3.4",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@types/temp": "^0.9.4",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "knip": "^6.44.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "prettier": "@freckle/prettier-config"
}
