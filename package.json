{
  "name": "weeder-action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Annotate unused functions in a Haskell project",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && ncc build lib/main.js --minify",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "knip": "knip",
    "readme": "npx action-docs -u && prettier --write README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/weeder-action.git"
  },
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/tool-cache": "^4.0.0",
    "semver": "^7.8.5",
    "temp": "^0.9.4"
  },
  "devDependencies": {
    "@freckle/eslint-config": "^1.3.3",
    "@freckle/prettier-config": "^1.3.3",
    "@freckle/tsconfig": "^1.3.3",
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "@types/temp": "^0.9.4",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "prettier": "@freckle/prettier-config"
}
